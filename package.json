{
    "name": "lifemem",
    "version": "0.0.1",
    "description": "LifeMem",
    "author": "ober0 Ruslan",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build && tsc -p prisma/tsconfig.json",
        "seed:dev": "ts-node -r tsconfig-paths/register ./prisma/seeds/seed.ts",
        "seed": "node dist/prisma-seed/prisma/seeds/seed.js",
        "dev": "concurrently -k -n api,cron-worker -c cyan,magenta \"npm run dev:api\" \"npm run dev:cron\"",
        "dev:api": "nest start --watch",
        "dev:cron": "wait-on dist/src/cron-worker.js && node --watch dist/src/cron-worker.js",
        "prod": "node dist/src/main.js",
        "prod:cron": "node dist/src/cron-worker.js",
        "generate": "npm run generate:i18n && npm run generate:prisma",
        "generate:prisma": "npx prisma generate --schema ./prisma/schema/",
        "generate:i18n": "ts-node src/translations/generate-types.ts",
        "migrate:make": "npx prisma migrate dev --schema ./prisma/schema/ --create-only",
        "migrate:apply": "npx prisma migrate deploy --schema ./prisma/schema/",
        "migrate:reset": "npx prisma migrate reset --force --schema ./prisma/schema/",
        "db:e2e": "node --env-file=.env.e2e ./node_modules/prisma/build/index.js migrate deploy --schema ./prisma/schema/ && node --env-file=.env.e2e ./node_modules/ts-node/dist/bin.js -r tsconfig-paths/register ./prisma/seeds/seed.ts",
        "lint": "eslint \"{src,test,prisma}/**/*.{ts,js}\" --fix",
        "lint:check": "eslint \"{src,test,prisma}/**/*.{ts,js}\"",
        "prisma:validate": "npx prisma validate --schema ./prisma/schema/",
        "format": "prettier --write \"{src,test,prisma}/**/*.{ts,js,json}\"",
        "test": "jest --passWithNoTests",
        "test:e2e": "npm run db:e2e && node --env-file=.env.e2e ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json --forceExit",
        "docker:prod": "docker compose --project-directory . -f deploy/docker-compose.yml -p lifemem-prod --env-file .env.prod up --build -d",
        "docker:prod:logs": "docker compose --project-directory . -f deploy/docker-compose.yml -p lifemem-prod --env-file .env.prod logs -f",
        "docker:prod:down": "docker compose --project-directory . -f deploy/docker-compose.yml -p lifemem-prod --env-file .env.prod down",
        "docker:dev": "docker compose --project-directory . -f deploy/docker-compose.dev.yml -p lifemem-dev up -d",
        "docker:dev:down": "docker compose --project-directory . -f deploy/docker-compose.dev.yml -p lifemem-dev down",
        "docker:e2e": "docker compose --project-directory . -f deploy/docker-compose.e2e.yml -p lifemem-e2e --env-file .env.e2e up -d --wait",
        "docker:e2e:down": "docker compose --project-directory . -f deploy/docker-compose.e2e.yml -p lifemem-e2e --env-file .env.e2e down -v"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.787.0",
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^5.0.1",
        "@nestjs/swagger": "^11.1.1",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/client": "6.19",
        "@scalar/nestjs-api-reference": "^1.2.14",
        "apple-signin-auth": "^2.1.0",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cookie-parser": "^1.4.7",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "express": "^5.1.0",
        "express-basic-auth": "^1.2.1",
        "google-auth-library": "^11.0.2",
        "ioredis": "^5.6.0",
        "jsonwebtoken": "^9.0.3",
        "libphonenumber-js": "^1.13.11",
        "nestjs-i18n": "^10.5.0",
        "nodemailer": "^6.10.0",
        "prisma": "6.19",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.10.7",
        "@types/nodemailer": "^6.4.17",
        "@types/supertest": "^6.0.2",
        "concurrently": "^10.0.5",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "wait-on": "^9.1.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "prisma": {
        "schema": "./prisma/schema",
        "seed": "ts-node -r tsconfig-paths/register ./prisma/seeds/seed.ts"
    }
}
