# Application
NODE_ENV=development
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lifemem
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/lifemem?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# S3 / MinIO
S3_BUCKET=lifemem
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniopassword

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASS=admin

# SMTP
SMTP_SERVICE_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: AES-256-GCM key (32 bytes hex) for encrypting error request bodies in logs
LOG_BODY_SECRET=
