# Application
NODE_ENV=test
PORT=3000

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lifemem_e2e
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/lifemem_e2e?schema=public

# Redis
REDIS_PORT=6380
REDIS_URL=redis://127.0.0.1:6380

# S3 / MinIO
S3_BUCKET=lifemem-e2e
S3_PORT=19002
S3_CONSOLE_PORT=19003
S3_ENDPOINT=http://127.0.0.1:19002
S3_REGION=ru-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniopassword

# Swagger
SWAGGER_USER=test
SWAGGER_PASS=test

# SMTP
SMTP_SERVICE_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

