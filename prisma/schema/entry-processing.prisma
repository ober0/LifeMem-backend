enum EntryProcessingStatus {
  Uploaded
  Transcribing
  VisionProcessing
  Enriching
  Vectorizing
  Ready
  Failed

  @@map("entry_processing_status")
}

enum EntryProcessingStageKind {
  Upload
  SttTranscription
  VisionCaption
  TextEnrichment
  EmbeddingText
  EmbeddingTitle
  EmbeddingImage

  @@map("entry_processing_stage_kind")
}

model EntryProcessing {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @unique @map("entry_id") @db.Uuid

  status       EntryProcessingStatus @default(Uploaded)
  errorMessage String?               @map("error_message")

  stages EntryProcessingStage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entry_processing")
}

model EntryProcessingStage {
  id String @id @default(uuid()) @db.Uuid

  processing   EntryProcessing @relation(fields: [processingId], references: [id], onDelete: Cascade)
  processingId String          @map("processing_id") @db.Uuid

  stage EntryProcessingStageKind

  model        String?
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  price        Decimal? @db.Decimal(12, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([processingId, createdAt])
  @@map("entry_processing_stage")
}
