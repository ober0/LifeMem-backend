enum EntryProcessingStatus {
  Pending
  Running
  Done
  Failed

  @@map("entry_processing_status")
}

enum EntryProcessingType {
  Stt
  Vision
  LocationConnect
  LocationAndPeopleDetect
  EmbedText
  EmbedTitle
  EmbedImage

  @@map("entry_processing_type")
}

model EntryProcessingJob {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @map("entry_id") @db.Uuid

  type   EntryProcessingType
  status EntryProcessingStatus @default(Pending)

  errorMessage String? @map("error_message")

  usage EntryProcessingUsage?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([entryId, type])
  @@index([entryId, status])
  @@map("entry_processing_job")
}

model EntryProcessingUsage {
  id String @id @default(uuid()) @db.Uuid

  job   EntryProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String             @unique @map("job_id") @db.Uuid

  model        AiModel  @relation(fields: [aiModelId], references: [id])
  aiModelId    String   @db.Uuid
  inputTokens  Int?     @map("input_tokens")
  outputTokens Int?     @map("output_tokens")
  price        Decimal? @db.Decimal(12, 6)

  provider String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entry_processing_usage")
}
