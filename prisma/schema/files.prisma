enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

model File {
  id String @id @default(uuid()) @db.Uuid

  key      String
  filename String?
  mimeType String?
  size     BigInt?
  type     FileType

  entryImage EntryImage[]
  entryVoice EntryVoice[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([key])
  @@map("file")
}
