model Password {
  id String @id @default(uuid()) @db.Uuid

  password String

  user User?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("password")
}

model User {
  id String @id @default(uuid()) @db.Uuid

  nickname String

  // Может отсутствовать для oauth и телефона
  passwordId String?   @unique @map("password_id") @db.Uuid
  password   Password? @relation(fields: [passwordId], references: [id])

  email       String? @unique
  phoneNumber String? @unique @map("phone_number")

  isEmailVerified Boolean @default(false) @map("is_email_verified")
  isPhoneVerified Boolean @default(false) @map("is_phone_verified")

  oauthProviders UserOAuthProvider[]
  confirmCodes   ConfirmCode[]
  authLogs       AuthLogs[]

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String @map("role_id") @db.Uuid

  refreshToken RefreshToken[]
  userSettings UserSettings?
  logs         Logs[]

  entries Entry[]

  people Person[]
  places Place[]
  things Thing[]

  deletedAt DateTime? @map("deletedAt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleId])
  @@index(email)
  @@index(phoneNumber)
  @@map("user")
}
