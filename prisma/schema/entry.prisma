model Entry {
  id String @id @default(uuid()) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid

  title               String
  text                String?
  formattedText       String?                   @map("formatted_text")
  formattedTextFormat EntryFormattedTextFormat? @map("formatted_text_format")

  voice EntryVoice?
  media EntryMedia[]

  vectors EntryVector[]

  isReady Boolean @default(false) @map("is_ready")

  jobs EntryProcessingJob[]

  people EntryPerson[]
  places EntryPlace[]

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, isReady, createdAt])
  @@index([userId, deletedAt])
  @@map("entry")
}

enum EntryFormattedTextFormat {
  plain
  markdown
  html

  @@map("entry_formatted_text_format")
}

model EntryMedia {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @map("entry_id") @db.Uuid

  type FileType

  file   File   @relation("EntryMediaFile", fields: [fileId], references: [id], onDelete: Cascade)
  fileId String @map("file_id") @db.Uuid

  firstFrame   File?   @relation("EntryMediaFirstFrame", fields: [firstFrameId], references: [id], onDelete: SetNull)
  firstFrameId String? @map("first_frame_id") @db.Uuid

  aiTranscription String? @map("ai_transcription")
  aiMetadata      Json?   @map("ai_metadata")
  description     String?

  vector EntryVector?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entry_media")
}

model EntryVoice {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @unique @map("entry_id") @db.Uuid

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String @map("file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entry_voice")
}

enum EntryVectorKind {
  Text
  Title
  Media

  @@map("entry_vector_kind")
}

model EntryVector {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @map("entry_id") @db.Uuid

  kind EntryVectorKind @default(Text)

  model     AiModel @relation(fields: [aiModelId], references: [id])
  aiModelId String  @map("ai_model_id") @db.Uuid

  media   EntryMedia? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId String?     @unique @map("media_id") @db.Uuid

  dimensions Int
  embedding  Unsupported("vector")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entryId])
  @@index([aiModelId])
  @@index([dimensions])
  @@map("entry_vector")
}
