model Entry {
  id String @id @default(uuid()) @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id") @db.Uuid

  title String
  text  String?

  voice  EntryVoice?
  images EntryImage[]

  vectors EntryVector[]

  isReady Boolean @default(false) @map("is_ready")

  jobs EntryProcessingJob[]

  people EntryPerson[]
  places EntryPlace[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, isReady, createdAt])
  @@map("entry")
}

model EntryImage {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @map("entry_id") @db.Uuid

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String @map("file_id") @db.Uuid

  aiTranscription String? @map("ai_transcription")
  description     String?

  vector EntryVector?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entry_image")
}

model EntryVoice {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @unique @map("entry_id") @db.Uuid

  file   File   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId String @map("file_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("entry_voice")
}

enum EntryVectorKind {
  Text
  Title
  Image

  @@map("entry_vector_kind")
}

model EntryVector {
  id String @id @default(uuid()) @db.Uuid

  entry   Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId String @map("entry_id") @db.Uuid

  kind EntryVectorKind @default(Text)

  model     AiModel @relation(fields: [aiModelId], references: [id])
  aiModelId String  @map("ai_model_id") @db.Uuid

  image   EntryImage? @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId String?     @unique @map("image_id") @db.Uuid

  dimensions Int
  embedding  Unsupported("vector")?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([entryId])
  @@index([aiModelId])
  @@index([dimensions])
  @@map("entry_vector")
}
