# Application
NODE_ENV=production
PORT=3000

# PostgreSQL
POSTGRES_USER=lifemem
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=lifemem
DATABASE_URL=postgresql://lifemem:change_me_postgres_password@lifemem-postgres:5432/lifemem?schema=public

# Redis
REDIS_URL=redis://lifemem-redis:6379

# S3 / MinIO (внутри docker-сети — lifemem-minio:9000)
S3_BUCKET=lifemem
S3_ENDPOINT=http://lifemem-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change_me_minio_user
S3_SECRET_ACCESS_KEY=change_me_minio_password
# доступ с хоста/снаружи (если 9000 занят)
S3_HOST_PORT=19000
S3_CONSOLE_HOST_PORT=19001

# Swagger basic auth
SWAGGER_USER=admin
SWAGGER_PASS=change_me_swagger_password

# SMTP
SMTP_SERVICE_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

LOG_BODY_SECRET=
