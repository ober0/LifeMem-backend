{
    "$schema": "https://json.schemastore.org/nest-cli",
    "collection": "@nestjs/schematics",
    "sourceRoot": "src",
    "compilerOptions": {
        "deleteOutDir": false,
        "assets": [
            "translations/**/*",
            {
                "include": "api/smtp/templates/**/*",
                "outDir": "dist/src",
                "watchAssets": true
            }
        ],
        "watchAssets": true
    }
}
